{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "aslnut": ["./src/index.ts"],
      "aslnut/*": ["./src/*/index.ts", "./src/*.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "vite.config.ts",
    "tools/compile"
  ],
  "exclude": [
    "examples/recipes/trials"
  ]
}
