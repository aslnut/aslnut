{
  "name": "aslnut",
  "version": "0.1.5",
  "description": "A world engine for the web: GIS, digital twins and 3D viz on WebGPU and WebGL2",
  "license": "Apache-2.0",
  "author": "aslnut",
  "repository": { "type": "git", "url": "https://github.com/aslnut/aslnut", "directory": "packages/aslnut" },
  "homepage": "https://github.com/aslnut/aslnut#readme",
  "bugs": "https://github.com/aslnut/aslnut/issues",
  "keywords": ["world", "webgpu", "webgl2", "gis", "digital-twin", "3d", "globe", "visualisation"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE", "DATA-LICENCES.md", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
    "./core/observation/observers/orbit": { "types": "./dist/core/observation/observers/orbit/index.d.ts", "default": "./dist/core/observation/observers/orbit/index.js" },
    "./core/data/loading": { "types": "./dist/core/data/loading/index.d.ts", "default": "./dist/core/data/loading/index.js" },
    "./core/data/loading/folder": { "types": "./dist/core/data/loading/folder.d.ts", "default": "./dist/core/data/loading/folder.js" },
    "./core/render/graphics/shaders": { "types": "./dist/core/render/graphics/shaders/index.d.ts", "default": "./dist/core/render/graphics/shaders/index.js" },
    "./modules/world": { "types": "./dist/modules/world/index.d.ts", "default": "./dist/modules/world/index.js" },
    "./modules/world/earth": { "types": "./dist/modules/world/earth/index.d.ts", "default": "./dist/modules/world/earth/index.js" },
    "./modules/world/plane": { "types": "./dist/modules/world/plane/index.d.ts", "default": "./dist/modules/world/plane/index.js" },
    "./kits/dashboard": { "types": "./dist/kits/dashboard/index.d.ts", "default": "./dist/kits/dashboard/index.js" },
    "./core/world/states": { "types": "./dist/core/world/states.d.ts", "default": "./dist/core/world/states.js" },
    "./core/data/sources": { "types": "./dist/core/data/sources/index.d.ts", "default": "./dist/core/data/sources/index.js" },
    "./modules/presets/humans": { "types": "./dist/modules/presets/humans/index.d.ts", "default": "./dist/modules/presets/humans/index.js" },
    "./modules/presets/shared": { "types": "./dist/modules/presets/shared/index.d.ts", "default": "./dist/modules/presets/shared/index.js" },
    "./modules/presets/vehicles": { "types": "./dist/modules/presets/vehicles/index.d.ts", "default": "./dist/modules/presets/vehicles/index.js" },
    "./modules/presets/drones": { "types": "./dist/modules/presets/drones/index.d.ts", "default": "./dist/modules/presets/drones/index.js" },
    "./tools": { "types": "./dist/tools.d.ts", "default": "./dist/tools.js" },
    "./tools/catalog": { "types": "./dist/tools/catalog.d.ts", "default": "./dist/tools/catalog.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc -p tsconfig.json && node tools/twins.mjs && node tools/api.mjs",
    "api": "node tools/api.mjs",
    "build": "tsc -p tsconfig.build.json",
    "examples": "vite build",
    "dev": "vite",
    "smoke": "node tools/smoke.mjs",
    "parity": "node tools/parity.mjs",
    "live": "node tools/live.mjs",
    "checks": "node tools/checks.mjs",
    "perf": "node tools/perf.mjs"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2",
    "clipper2-ts": "^2.0.1-18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.59.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
